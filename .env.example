# Flask settings
SECRET_KEY=dev-secret-key-change-this
DATABASE_URL=sqlite:///life_tracker.db

# Email / SMTP Configuration (Optional: if empty, OTPs are printed to the server terminal in Dev Mode)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_DEFAULT_SENDER="Life Tracker <your-email@gmail.com>"

# OTP & Password Reset Settings
OTP_EXPIRY_MINUTES=10
RESET_PASSWORD_WINDOW_MINUTES=5
